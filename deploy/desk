#!/usr/bin/env bash
# 'desk' - everyday commands for the crypto trading desk (installed by deploy/setup.sh).
APP_DIR="__APP_DIR__"
SERVICE="__SERVICE__"
cd "$APP_DIR" || exit 1
PY="$APP_DIR/.venv/bin/python"
SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

case "${1:-help}" in
  status)
    if systemctl is-active --quiet "$SERVICE"; then
      echo "✅ Running since $(systemctl show -p ActiveEnterTimestamp --value "$SERVICE")"
    else
      echo "⛔ Not running. Start it with: desk start   (see why with: desk logs)"
    fi
    echo; echo "Latest activity:"
    $SUDO journalctl -u "$SERVICE" -n 12 --no-pager -o cat
    "$PY" -m trader report ;;
  report)  "$PY" -m trader report ;;
  logs)    echo "Live view - press Ctrl+C to stop watching (the desk keeps running)."
           $SUDO journalctl -u "$SERVICE" -n 50 -f -o cat ;;
  start)   $SUDO systemctl start "$SERVICE" && echo "Started." ;;
  stop)    $SUDO systemctl stop "$SERVICE" && echo "Stopped. Start again with: desk start" ;;
  restart) $SUDO systemctl restart "$SERVICE" && echo "Restarted." ;;
  setup)   $SUDO systemctl stop "$SERVICE"  # pause trading (and Telegram) while settings change
           "$PY" -m trader setup
           $SUDO systemctl start "$SERVICE" && echo "The desk is running with your settings." ;;
  check)   "$PY" -m trader check ;;
  reset)   $SUDO systemctl stop "$SERVICE"
           if "$PY" -m trader reset ${2:-}; then echo "The demo starts fresh from now on."; fi
           $SUDO systemctl start "$SERVICE" ;;
  update)  "$PY" -m trader update --force ;;
  logs-update) $SUDO journalctl -u "$SERVICE-update" -n 60 --no-pager -o cat ;;
  version) "$PY" -m trader version ;;
  backtest) shift; "$PY" -m trader backtest "$@" ;;
  library) shift
           # A background service beside the desk, not a child of this login: it keeps the lowest CPU weight against
           # the desk (a nice value alone only counts inside one login session) and keeps running if you disconnect.
           UNIT="$SERVICE-library"
           if ! command -v systemd-run >/dev/null 2>&1; then
             "$PY" -m trader library --save --low-priority "$@"; exit $?
           fi
           if systemctl is-active --quiet "$UNIT"; then
             echo "A library run is already going. Watch it with: $SUDO journalctl -u $UNIT -f -o cat"; exit 1
           fi
           SINCE="$(date '+%Y-%m-%d %H:%M:%S')"
           $SUDO systemd-run --quiet --collect --unit="$UNIT" --uid="$(stat -c %U "$APP_DIR")" \
             --gid="$(stat -c %G "$APP_DIR")" --working-directory="$APP_DIR" -p Nice=19 -p CPUWeight=1 \
             -p IOSchedulingClass=idle -p OOMScoreAdjust=1000 "$PY" -m trader library --save --low-priority "$@" || exit 1
           echo "Started in the background at the lowest priority; it keeps running if you disconnect. Showing its"
           echo "progress (Ctrl+C stops watching only). The result: data/library/LIBRARY.md, or /library last on Telegram."
           $SUDO journalctl -u "$UNIT" -f -o cat --since "$SINCE" &
           WATCH=$!
           trap 'kill $WATCH 2>/dev/null; echo; echo "Stopped watching; the run continues."; exit 0' INT
           while systemctl is-active --quiet "$UNIT"; do sleep 3; done
           sleep 2; kill $WATCH 2>/dev/null ;;
  notes)   "$PY" -m trader notes ${2:-}
           echo "Read them here with:  less $APP_DIR/data/notes/STRATEGY.md   or send /notes to the bot to get the zip on your phone." ;;
  *) cat <<'EOF'
desk status    is it running? latest activity and performance
desk report    full performance report
desk logs      watch the agents live (Ctrl+C to stop watching)
desk start     start trading
desk stop      stop trading
desk restart   restart
desk setup     change keys or settings (restarts afterwards)
desk check     test connections to Binance, news, forex, Claude, Telegram
desk reset     start the demo from scratch (old results kept in a backup file; add --force if positions are open)
desk update    install the latest code now (tested first, restarts itself; also happens automatically)
desk version   which version is running, and whether a newer one exists
desk backtest  replay a strategy on real prices, e.g.  desk backtest --strategy trend --days 365
desk library   test published trading rules on years of real prices (20-40 min; trades nothing)
desk notes     rebuild the Markdown notebook (data/notes): strategies, trades, diary, results; add --zip for a zip file
EOF
  ;;
esac
