# ---- Mode -------------------------------------------------------------
# simulation : no exchange account needed; trades are filled by a local paper broker
#              at real Binance prices (or synthetic prices with --offline).
# testnet    : real orders on the Binance Spot TESTNET (fake money, real API).
#              Analysis always uses real market prices in both modes.
# Live trading with real money is deliberately NOT supported in this phase.
TRADING_MODE=simulation

# ---- Binance Spot Testnet keys (https://testnet.binance.vision -> "Generate HMAC_SHA256 Key")
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

SETTINGS_VERSION=2

# ---- Claude (optional). Without a key the agents use built-in rules instead of AI reasoning.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=5        # after this much Claude spend in a day, use the free rules until 00:00 UTC (0 = no cap)

# ---- Updates -------------------------------------------------------------
AUTO_UPDATE=true             # install new code from GitHub automatically (tested first); false = only notify

# ---- Telegram alerts (optional) - easiest to set up with: python -m trader setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_HOUR_UTC=6

# ---- What to trade ----------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT   # core coins, always watched
AUTO_COINS=true              # let the Market Scout add coins it finds (AI web research with Claude)
MAX_COINS=8                  # most coins watched at once, core included
SCOUT_HOURS=6                # how often the scout refreshes the list
MIN_VOLUME_MUSD=10           # ignore coins with less than $10M traded in 24h
CANDLE_INTERVAL=1h

# ---- Timing ---------------------------------------------------------------
CYCLE_MINUTES=15             # normal time between market checks
MIN_CHECK_MINUTES=5          # the AI (or a position near its stop) may check this often
MAX_CHECK_MINUTES=60         # the AI may slow down to this when markets are calm
NEWS_REFRESH_MINUTES=30
STARTING_BALANCE_USDT=10000

# ---- Risk limits (the Risk Manager agent enforces these; it can veto any trade)
RISK_PER_TRADE_PCT=0.01      # Turtle sizing: a stop-loss costs 1% of equity (0 = fixed MAX_POSITION_PCT size)
MAX_POSITION_PCT=0.15        # never more than 15% of equity in one coin
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.03      # stop opening trades after -3% in a day
MAX_DRAWDOWN_PCT=0.10        # stop opening trades once 10% below the starting balance (0 = off)
MIN_CONFIDENCE=0.60          # decisions below this confidence are ignored
STOP_LOSS_ATR=2.0            # initial stop-loss distance = 2 x ATR
TAKE_PROFIT_ATR=4.0          # take-profit distance = 4 x ATR (2:1 reward-to-risk)
TRAIL_ATR=2.0                # trailing stop: follows the highest price at 2 x ATR (0 = off)

# ---- Master traders' checklist (trader/agents/mentor.py) ------------------
# trend200 = above 200-day average (Paul Tudor Jones), btc = Bitcoin above its 200-day average,
# cooldown = no re-entry 24h after a stop-loss (Livermore), reward = at least 2:1 reward-to-risk (PTJ),
# alignment = Minervini trend template, overextended = not chasing. 'none' switches the checklist off.
MENTOR_CHECKS=trend200,btc,cooldown,reward
MIN_REWARD_RISK=2.0
COOLDOWN_HOURS=24
