# ---- Mode -------------------------------------------------------------
# simulation : no exchange account needed; trades are filled by a local paper broker
#              at real Binance public prices (or synthetic prices with --offline).
# testnet    : real orders on the Binance Spot TESTNET (fake money, real API).
# Live trading with real money is deliberately NOT supported in this phase.
TRADING_MODE=simulation

# ---- Binance Spot Testnet keys (https://testnet.binance.vision -> "Generate HMAC_SHA256 Key")
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# ---- Claude (optional). Without a key the agents use built-in rules instead of AI reasoning.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- What to trade ----------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
CANDLE_INTERVAL=1h
CYCLE_MINUTES=60
STARTING_BALANCE_USDT=10000

# ---- Risk limits (the Risk Manager agent enforces these; it can veto any trade)
MAX_POSITION_PCT=0.10        # max 10% of equity in one trade
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.03      # stop opening trades after -3% in a day
MIN_CONFIDENCE=0.60          # decisions below this confidence are ignored
STOP_LOSS_ATR=2.0            # stop-loss distance = 2 x ATR
TAKE_PROFIT_ATR=3.0          # take-profit distance = 3 x ATR
