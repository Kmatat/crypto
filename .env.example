# ---- Mode -------------------------------------------------------------
# simulation : no exchange account needed; trades are filled by a local paper broker
#              at real Binance prices (or synthetic prices with --offline).
# testnet    : real orders on the Binance Spot TESTNET (fake money, real API).
#              Analysis always uses real market prices in both modes.
# Live trading with real money is deliberately NOT supported in this phase.
TRADING_MODE=simulation

# ---- Binance Spot Testnet keys (https://testnet.binance.vision -> "Generate HMAC_SHA256 Key")
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

SETTINGS_VERSION=3

# ---- Claude (optional). Without a key the agents use built-in rules instead of AI reasoning.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DAILY_BUDGET_USD=5        # after this much Claude spend in a day (real money), use the free rules until 00:00 UTC
                             # (0 = no cap). /aibudget on Telegram shows today's spend and changes it (at most $20 a day)
#AI_BUDGET_PCT_MONTH=0.25    # optional extra cap: at most this % of the account a month ($25 on $10,000). Off on demo
                             # money, where the account is fake and a small one would starve Claude (1 cent a day on $100)

# ---- A free AI (optional, no cost): reads the news and double-checks buys and sells within its daily allowance ----
# FREE_AI_PROVIDER: gemini (recommended, key at https://aistudio.google.com), groq, mistral, cloudflare, openrouter
# or custom; empty = none
FREE_AI_PROVIDER=
FREE_AI_API_KEY=
# FREE_AI_MODELS: empty = the provider's recommended models, tried in order
FREE_AI_MODELS=
# FREE_AI_BASE_URL: custom services; Cloudflare: https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1
FREE_AI_BASE_URL=
FREE_AI_DAILY_REQUESTS=0     # requests a day per model the desk allows itself; 0 = the provider's default
AI_ORDER=free-first          # free-first: the free AI answers, Claude only when it cannot; claude-first: the opposite

# ---- Strategy laboratory: the desk proposes, tests and promotes strategy variants itself ----
LAB_ENABLED=true
HEAD_TRADER=true             # the head trader paces Claude's budget, tilts thresholds for the portfolio, runs the threshold study
LAB_WEEKDAY=0                # 0 = Monday: weekly research + exam, reported on Telegram
LAB_ALT_SYMBOLS=BNB,XRP,ADA  # a challenger must also survive this second coin set
RESEARCH_CANDIDATES=3        # proposals per week (Claude with web research, or neighbours of the champion)
AUTO_PROMOTE=false           # false = a challenger that passed everything still needs your /approve on Telegram

# ---- Updates -------------------------------------------------------------
AUTO_UPDATE=true             # install new code from GitHub automatically (tested first); false = only notify

# ---- Telegram alerts (optional) - easiest to set up with: python -m trader setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_HOUR_UTC=6
PULSE_HOURS=6                # a short "this is what the desk did" message this often (0 = off)

# ---- Strategy ---------------------------------------------------------
# trend  : the daily trend rule (recommended; README "The daily trend strategy"): hold a coin while its daily close
#          is above its 50-day average, emergency stop 25% below the entry, decisions once a day after 00:00 UTC,
#          no AI. Use the 8 tested coins below, MAX_OPEN_POSITIONS=8 and AUTO_COINS=false.
# hourly : the agents' hourly signals with news and AI opinions (lost money after fees in every replay)
STRATEGY=hourly
TREND_SMA_DAYS=50            # the average the daily close is compared with
TREND_VOL_TARGET=0.5         # a coin swinging more than this a year (0.5 = 50%) gets a smaller share; 0.25 = calmer
TREND_STOP_PCT=0.25          # emergency stop this far below the entry (lives on Binance)
#SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,LINKUSDT   # the coins the trend rule was tested on

# ---- What to trade ----------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT   # core coins, always watched
AUTO_COINS=true              # let the Market Scout add coins it finds (AI web research with Claude)
MAX_COINS=8                  # most coins watched at once, core included
SCOUT_HOURS=6                # how often the scout refreshes the list
MIN_VOLUME_MUSD=10           # ignore coins with less than $10M traded in 24h
CANDLE_INTERVAL=1h

# ---- Timing ---------------------------------------------------------------
CYCLE_MINUTES=15             # normal time between market checks
MIN_CHECK_MINUTES=5          # the AI (or a position near its stop) may check this often
MAX_CHECK_MINUTES=60         # the AI may slow down to this when markets are calm
NEWS_REFRESH_MINUTES=30
STARTING_BALANCE_USDT=10000

# ---- Risk limits (the Risk Manager agent enforces these; it can veto any trade)
RISK_PER_TRADE_PCT=0.01      # Turtle sizing: a stop-loss costs 1% of equity (0 = fixed MAX_POSITION_PCT size)
MAX_POSITION_PCT=0.10        # never more than 10% of equity in one coin (the risk rule can only shrink this)
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PCT=0.03      # stop opening trades after -3% in a day
MAX_DRAWDOWN_PCT=0.10        # stop opening trades once 10% below the starting balance (0 = off)
BRAKE_PAUSE_DAYS=14          # after that brake trips: pause 14 days, then trade again at half size until recovered
MIN_CONFIDENCE=0.60          # decisions below this confidence are ignored
STOP_LOSS_ATR=2.0            # initial stop-loss distance = 2 x ATR
TAKE_PROFIT_ATR=4.0          # take-profit distance = 4 x ATR (2:1 reward-to-risk)
TRAIL_ATR=2.0                # trailing stop: follows the highest price at 2 x ATR (0 = off)

# ---- Master traders' checklist (trader/agents/mentor.py) ------------------
# trend200 = above 200-day average (Paul Tudor Jones), btc = Bitcoin above its 200-day average,
# cooldown = no re-entry 24h after a stop-loss (Livermore), reward = at least 2:1 reward-to-risk (PTJ),
# alignment = Minervini trend template, overextended = not chasing. 'none' switches the checklist off.
MENTOR_CHECKS=trend200,btc,cooldown,reward
MIN_REWARD_RISK=2.0
COOLDOWN_HOURS=24
